<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KineticTrainer.App.Controls.LineChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="120">

    <Grid RowSpacing="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource KineticLabelStyle}" />

        <Grid Grid.Row="1" Grid.Column="0">
            <TextBlock x:Name="MaxLabel" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="12" Opacity="0.7" Margin="0,0,6,0" />
            <TextBlock x:Name="MidLabel" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.7" Margin="0,0,6,0" />
            <TextBlock x:Name="MinLabel" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="12" Opacity="0.7" Margin="0,0,6,0" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" BorderThickness="1" BorderBrush="{ThemeResource KineticBorderSubtleBrush}" CornerRadius="2"
                Background="{ThemeResource KineticSurfaceBrush}">
            <Canvas x:Name="PlotCanvas" SizeChanged="OnSizeChanged">
                <Line x:Name="MidLine" StrokeThickness="1" Stroke="{ThemeResource KineticBorderSubtleBrush}" StrokeDashArray="4,4" />
                <Line x:Name="RefLine" StrokeThickness="1" Stroke="{ThemeResource KineticTextSecondaryBrush}" StrokeDashArray="6,3" Visibility="Collapsed" />
                <Polyline x:Name="Line2" StrokeThickness="2" StrokeLineJoin="Round" />
                <Polyline x:Name="Line" StrokeThickness="2" StrokeLineJoin="Round" />
            </Canvas>
        </Border>

        <Grid Grid.Row="2" Grid.Column="1">
            <TextBlock x:Name="StartLabel" HorizontalAlignment="Left" FontSize="12" Opacity="0.7" />
            <TextBlock x:Name="EndLabel" HorizontalAlignment="Right" FontSize="12" Opacity="0.7" />
        </Grid>
    </Grid>
</UserControl>
