<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KineticTrainer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Kinetic Trainer">

    <Grid Background="{ThemeResource KineticBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status bar: connection, sensor, bridge, rider -->
        <Grid Grid.Row="0" Padding="16,6" ColumnSpacing="14" Background="{ThemeResource KineticSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="KINETIC TRAINER" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{ThemeResource KineticAccentBrush}" VerticalAlignment="Center" />
            <Ellipse Grid.Column="1" Width="12" Height="12" VerticalAlignment="Center" Fill="{x:Bind Status.StateBrush, Mode=OneWay}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Status.StateText, Mode=OneWay}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource KineticTextSecondaryBrush}" Text="{x:Bind Status.SensorText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{ThemeResource KineticTextSecondaryBrush}" Text="{x:Bind Status.RateText, Mode=OneWay}" />
            <TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="{ThemeResource KineticTextSecondaryBrush}" Opacity="0.7" Text="{x:Bind Status.BridgeText, Mode=OneWay}" />
            <Button Grid.Column="6" x:Name="RiderButton" Padding="6,2" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Switch rider">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Grid Width="26" Height="26">
                        <Ellipse Fill="{x:Bind Status.RiderBrush, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Status.RiderInitials, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{x:Bind Status.RiderText, Mode=OneWay}" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="RiderMenu" Opening="RiderMenu_Opening" />
                </Button.Flyout>
            </Button>
        </Grid>

        <NavigationView Grid.Row="1" x:Name="Nav" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        IsPaneToggleButtonVisible="True" OpenPaneLength="200" SelectionChanged="Nav_SelectionChanged" Loaded="Nav_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Ride" Tag="ride">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Workouts" Tag="workouts">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="history">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Trends" Tag="trends">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profile" Tag="profile">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Sensor" Tag="sensor">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE702;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Debug" Tag="debug">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEBE8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
