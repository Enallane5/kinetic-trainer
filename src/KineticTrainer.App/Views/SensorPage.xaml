<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KineticTrainer.App.Views.SensorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:KineticTrainer.App.ViewModels"
    NavigationCacheMode="Required"
    Background="{ThemeResource KineticBackgroundBrush}">

    <ScrollViewer>
        <Grid Padding="24" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Left: discovery -->
            <StackPanel Grid.Column="0" Spacing="12">
                <TextBlock Text="Sensor" Style="{StaticResource KineticPageTitleStyle}" />
                <TextBlock Text="FIND YOUR INRIDE" Style="{StaticResource KineticSectionHeaderStyle}" />
                <TextBlock Text="{x:Bind ViewModel.BluetoothStatus, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="{x:Bind ViewModel.ScanButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleScanCommand}" Style="{StaticResource KineticPrimaryButtonStyle}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="20" Height="20" />
                    <CheckBox Content="Show all Bluetooth devices" IsChecked="{x:Bind ViewModel.ShowAllDevices, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Text="Wake the sensor by spinning the trainer roller. inRide devices are listed first." Opacity="0.7" TextWrapping="Wrap" />

                <ListView ItemsSource="{x:Bind ViewModel.Devices}" SelectionMode="None" MaxHeight="420" BorderThickness="1"
                          BorderBrush="{ThemeResource KineticBorderSubtleBrush}" Background="{ThemeResource KineticSurfaceBrush}" CornerRadius="2">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceItem">
                            <Grid Padding="4,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Border Background="{ThemeResource KineticAccentBrush}" Padding="6,1"
                                                Visibility="{x:Bind LooksLikeInRide, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind Badge, Mode=OneWay}" FontSize="11" Foreground="Black" />
                                        </Border>
                                        <Border Background="DarkOrange" CornerRadius="4" Padding="6,1" Visibility="{x:Bind IsSimulated}">
                                            <TextBlock Text="SIMULATED" FontSize="11" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind AddressText}" FontFamily="{StaticResource MonoFont}" Opacity="0.7" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind RssiText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
                                <Button Grid.Column="2" Content="Connect" Command="{x:Bind ConnectCommand}" CommandParameter="{x:Bind}" Style="{StaticResource KineticOutlineButtonStyle}" Padding="14,6" MinHeight="34" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" Foreground="{ThemeResource KineticDangerBrush}" TextWrapping="Wrap" />

                <TextBlock Text="SPIN-DOWN CALIBRATION" Style="{StaticResource KineticSectionHeaderStyle}" />
                <Border Style="{StaticResource KineticCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Calibrate" Command="{x:Bind ViewModel.CalibrateCommand}" Style="{StaticResource KineticOutlineButtonStyle}" />
                            <TextBlock Text="Opens the calibration prompt on the Ride screen. The sensor must be connected." VerticalAlignment="Center"
                                       Foreground="{ThemeResource KineticTextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="320" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.CalibrationSummary, Mode=OneWay}" Foreground="{ThemeResource KineticTextSecondaryBrush}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Calibrations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalibrationRow">
                                    <Grid ColumnSpacing="12" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Date}" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Outcome}" Foreground="{x:Bind Brush}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" TextWrapping="Wrap"><Run Text="{x:Bind Result}" /><Run Text="  " /><Run Text="{x:Bind Window}" Foreground="{ThemeResource KineticTextSecondaryBrush}" /></TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right: current connection -->
            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock Text=" " Style="{StaticResource KineticPageTitleStyle}" />
                <TextBlock Text="CONNECTION" Style="{StaticResource KineticSectionHeaderStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Disconnect" Command="{x:Bind ViewModel.DisconnectCommand}" Style="{StaticResource KineticDangerButtonStyle}" />
                    <Button Content="Connect remembered sensor" Command="{x:Bind ViewModel.ConnectRememberedCommand}" Style="{StaticResource KineticOutlineButtonStyle}" />
                    <Button Content="Forget" Command="{x:Bind ViewModel.ForgetSensorCommand}" Style="{StaticResource KineticOutlineButtonStyle}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.RememberedText, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" />

                <TextBlock Text="Device information" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                <TextBlock Text="{x:Bind ViewModel.DeviceInfoText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                <TextBlock Text="{x:Bind ViewModel.ProtocolText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsInRideProtocol, Mode=OneWay}">
                    <TextBlock Text="Sensor update rate" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox ItemsSource="{x:Bind ViewModel.RateOptions}" SelectedIndex="{x:Bind ViewModel.SelectedRateIndex, Mode=TwoWay}" MinWidth="160" />
                        <Button Content="Apply to sensor" Command="{x:Bind ViewModel.ApplyRateCommand}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.RateStatus, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                    <TextBlock Text="Configuration" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Content="Read now" Command="{x:Bind ViewModel.ReadConfigurationCommand}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.ConfigurationText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
