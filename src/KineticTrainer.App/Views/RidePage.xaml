<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KineticTrainer.App.Views.RidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:KineticTrainer.App.Controls"
    xmlns:vm="using:KineticTrainer.App.ViewModels"
    NavigationCacheMode="Required"
    Background="{ThemeResource KineticBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource KineticLabelStyle}" />
        <Style x:Key="TileNumber" TargetType="TextBlock" BasedOn="{StaticResource KineticTileNumberStyle}">
            <Setter Property="LineHeight" Value="0" />
            <Setter Property="LineStackingStrategy" Value="MaxHeight" />
        </Style>
        <Style x:Key="TileUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{ThemeResource KineticTextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="6,0,0,8" />
        </Style>
        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource KineticOutlineButtonStyle}">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid Padding="12,8,12,12" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: rider, workout name -->
            <Grid Grid.Row="0" Margin="4,0,4,6" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.RiderText, Mode=OneWay}" Foreground="{ThemeResource KineticTextSecondaryBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.HasWorkout, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.WorkoutName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.WorkoutInfoText, Mode=OneWay}" Foreground="{ThemeResource KineticTextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="COASTING" FontWeight="SemiBold" Foreground="{ThemeResource KineticWarningBrush}" VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.IsCoasting, Mode=OneWay}" />
            </Grid>

            <!-- Zone banner (workouts): Kinetic's full-width green strip, coloured by the target zone -->
            <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.HasWorkout, Mode=OneWay}" Background="{x:Bind ViewModel.SegmentBrush, Mode=OneWay}" Padding="16,6" Margin="4,0,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.SegmentText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="Black" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NextText, Mode=OneWay}" FontSize="16" Foreground="Black" VerticalAlignment="Center" Opacity="0.8" />
            </Grid>

            <!-- HUD -->
            <Grid Grid.Row="2" Opacity="{x:Bind ViewModel.ValuesOpacity, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Left top: interval countdown (workout) or ride time -->
                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource KineticTileStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource TileLabel}" Text="INTERVAL REMAINING" Visibility="{x:Bind ViewModel.HasWorkout, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource TileLabel}" Text="RIDE TIME" Visibility="{x:Bind c:Bind.Collapsed(ViewModel.HasWorkout), Mode=OneWay}" />
                        <Viewbox Grid.Row="1" HorizontalAlignment="Left" MaxHeight="120">
                            <Grid>
                                <TextBlock Style="{StaticResource KineticTimerStyle}" LineHeight="0" LineStackingStrategy="MaxHeight"
                                           Text="{x:Bind ViewModel.IntervalRemainingText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasWorkout, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource KineticTimerStyle}" LineHeight="0" LineStackingStrategy="MaxHeight"
                                           Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" Visibility="{x:Bind c:Bind.Collapsed(ViewModel.HasWorkout), Mode=OneWay}" />
                            </Grid>
                        </Viewbox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Visibility="{x:Bind ViewModel.HasWorkout, Mode=OneWay}">
                            <TextBlock Foreground="{ThemeResource KineticTextSecondaryBrush}" FontSize="16">
                                <Run Text="elapsed" /> <Run Text="{x:Bind ViewModel.WorkoutElapsedText, Mode=OneWay}" Foreground="White" />
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource KineticTextSecondaryBrush}" FontSize="16">
                                <Run Text="left" /> <Run Text="{x:Bind ViewModel.WorkoutRemainingText, Mode=OneWay}" Foreground="White" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Left bottom: target (workout) or average power -->
                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource KineticTileStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource TileLabel}" Text="TARGET" Visibility="{x:Bind ViewModel.HasWorkout, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource TileLabel}" Text="AVERAGE POWER" Visibility="{x:Bind c:Bind.Collapsed(ViewModel.HasWorkout), Mode=OneWay}" />
                        <Viewbox Grid.Row="1" HorizontalAlignment="Left" MaxHeight="96">
                            <Grid>
                                <TextBlock Style="{StaticResource TileNumber}" Foreground="{ThemeResource KineticChartPowerBrush}"
                                           Text="{x:Bind ViewModel.TargetText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasWorkout, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Visibility="{x:Bind c:Bind.Collapsed(ViewModel.HasWorkout), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource TileNumber}" Foreground="{ThemeResource KineticChartPowerBrush}" Text="{x:Bind ViewModel.AvgPowerText, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource TileUnit}" Text="W" />
                                </StackPanel>
                            </Grid>
                        </Viewbox>
                        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.FtpNoteText, Mode=OneWay}" Foreground="{ThemeResource KineticWarningBrush}" TextWrapping="Wrap" FontSize="13"
                                   Visibility="{x:Bind c:Bind.VisibleIfText(ViewModel.FtpNoteText), Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- Hero: current power. The frame shows on/under/over target. -->
                <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource KineticTileStyle}" BorderThickness="4" BorderBrush="{x:Bind ViewModel.TargetStateBrush, Mode=OneWay}">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource TileLabel}" Text="POWER" />
                            <TextBlock Text="{x:Bind ViewModel.TargetStateText, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="18"
                                       Foreground="{x:Bind ViewModel.TargetStateBrush, Mode=OneWay}" />
                        </Grid>
                        <Viewbox Grid.Row="1" MaxHeight="300">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource KineticHeroNumberStyle}" LineHeight="0" LineStackingStrategy="MaxHeight" Text="{x:Bind ViewModel.PowerText, Mode=OneWay}" />
                                <TextBlock Text="W" FontSize="32" Foreground="{ThemeResource KineticTextSecondaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,20" />
                            </StackPanel>
                        </Viewbox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                            <Rectangle Width="14" Height="14" Fill="{x:Bind ViewModel.PowerZoneBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.PowerZoneText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.PowerZoneBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.PercentFtpText, Mode=OneWay}" FontSize="18" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="3" ColumnSpacing="8" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource TileLabel}" Text="3 S AVG" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource KineticStatNumberStyle}" FontSize="32" Text="{x:Bind ViewModel.Avg3sText, Mode=OneWay}" HorizontalAlignment="Center" Foreground="{ThemeResource KineticChartPowerBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource TileLabel}" Text="10 S AVG" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource KineticStatNumberStyle}" FontSize="32" Text="{x:Bind ViewModel.Avg10sText, Mode=OneWay}" HorizontalAlignment="Center" Foreground="{ThemeResource KineticChartPowerBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right: cadence and speed -->
                <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource KineticTileStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource TileLabel}" Text="CADENCE" />
                        <Viewbox Grid.Row="1" HorizontalAlignment="Left" MaxHeight="120">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TileNumber}" Foreground="{ThemeResource KineticChartCadenceBrush}" Text="{x:Bind ViewModel.CadenceText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource TileUnit}" Text="rpm" />
                            </StackPanel>
                        </Viewbox>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource KineticTileStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource TileLabel}" Text="SPEED" />
                        <Viewbox Grid.Row="1" HorizontalAlignment="Left" MaxHeight="120">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TileNumber}" Foreground="{ThemeResource KineticChartSpeedBrush}" Text="{x:Bind ViewModel.SpeedText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource TileUnit}" Text="{x:Bind ViewModel.SpeedUnit, Mode=OneWay}" />
                            </StackPanel>
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Small tiles -->
            <Grid Grid.Row="3" Opacity="{x:Bind ViewModel.ValuesOpacity, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KineticTileStyle}" Padding="12,6">
                    <Grid>
                        <StackPanel Visibility="{x:Bind ViewModel.HasWorkout, Mode=OneWay}">
                            <TextBlock Style="{StaticResource TileLabel}" Text="RIDE TIME" />
                            <TextBlock Style="{StaticResource KineticStatNumberStyle}" FontSize="30" Foreground="{ThemeResource KineticAccentBrush}" Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Visibility="{x:Bind c:Bind.Collapsed(ViewModel.HasWorkout), Mode=OneWay}">
                            <TextBlock Style="{StaticResource TileLabel}" Text="MAX POWER" />
                            <TextBlock Style="{StaticResource KineticStatNumberStyle}" FontSize="30" Foreground="{ThemeResource KineticChartPowerBrush}">
                                <Run Text="{x:Bind ViewModel.MaxPowerText, Mode=OneWay}" /><Run Text=" W" FontSize="16" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource KineticTileStyle}" Padding="12,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="DISTANCE" />
                        <TextBlock Style="{StaticResource KineticStatNumberStyle}" FontSize="30" Foreground="{ThemeResource KineticAccentBrush}">
                            <Run Text="{x:Bind ViewModel.DistanceText, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.DistanceUnit, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource KineticTileStyle}" Padding="12,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="AVG POWER" />
                        <TextBlock Style="{StaticResource KineticStatNumberStyle}" FontSize="30" Foreground="{ThemeResource KineticChartPowerBrush}">
                            <Run Text="{x:Bind ViewModel.AvgPowerText, Mode=OneWay}" /><Run Text=" W" FontSize="16" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource KineticTileStyle}" Padding="12,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="WORK" />
                        <TextBlock Style="{StaticResource KineticStatNumberStyle}" FontSize="30">
                            <Run Text="{x:Bind ViewModel.WorkText, Mode=OneWay}" /><Run Text=" kJ" FontSize="16" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Profile strip (workout) or rolling power graph -->
            <Grid Grid.Row="4" Height="160" Margin="4,4,4,4">
                <c:WorkoutProfileChart x:Name="ProfileChart"
                                       Timeline="{x:Bind ViewModel.Timeline, Mode=OneWay}"
                                       Ftp="{x:Bind ViewModel.ChartFtp, Mode=OneWay}"
                                       ElapsedSeconds="{x:Bind ViewModel.WorkoutElapsed, Mode=OneWay}"
                                       ColorByZone="{x:Bind ViewModel.ColorByZone, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.HasWorkout, Mode=OneWay}" />
                <Grid Visibility="{x:Bind c:Bind.Collapsed(ViewModel.HasWorkout), Mode=OneWay}">
                    <c:LineChart x:Name="LiveChart" Title="POWER" Unit="W" />
                    <ComboBox HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="110" Margin="0,-6,0,0"
                              ItemsSource="{x:Bind ViewModel.GraphChoiceLabels}" SelectedIndex="{x:Bind ViewModel.GraphIndex, Mode=TwoWay}" />
                </Grid>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="5" Margin="4,4,4,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Bind ViewModel.RideButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleRideCommand}" Style="{StaticResource KineticPrimaryButtonStyle}" MinWidth="140" />
                    <Button Content="{x:Bind ViewModel.WorkoutButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.StartWorkoutCommand}" Style="{StaticResource KineticPrimaryButtonStyle}"
                            Visibility="{x:Bind c:Bind.VisibleIfFirstOnly(ViewModel.HasWorkout, ViewModel.IsWorkoutActive), Mode=OneWay}" />
                    <Button Content="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.PauseResumeWorkoutCommand}" Style="{StaticResource FooterButton}"
                            Visibility="{x:Bind ViewModel.IsWorkoutActive, Mode=OneWay}" />
                    <Button Content="Skip" Command="{x:Bind ViewModel.SkipSegmentCommand}" Style="{StaticResource FooterButton}" Visibility="{x:Bind ViewModel.IsWorkoutActive, Mode=OneWay}"
                            ToolTipService.ToolTip="Jump to the next segment" />
                    <Button Content="End ramp" Command="{x:Bind ViewModel.EndRampCommand}" Style="{StaticResource KineticPrimaryButtonStyle}" Visibility="{x:Bind ViewModel.CanEndRamp, Mode=OneWay}"
                            ToolTipService.ToolTip="Press when you can no longer hold the target" />
                    <StackPanel Orientation="Horizontal" Spacing="2" Visibility="{x:Bind ViewModel.IsWorkoutActive, Mode=OneWay}" VerticalAlignment="Center">
                        <Button Content="−" Command="{x:Bind ViewModel.IntensityDownCommand}" Style="{StaticResource FooterButton}" Padding="12,8" ToolTipService.ToolTip="Targets −5 %" />
                        <TextBlock Text="{x:Bind ViewModel.IntensityText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="52" TextAlignment="Center" FontSize="16" />
                        <Button Content="+" Command="{x:Bind ViewModel.IntensityUpCommand}" Style="{StaticResource FooterButton}" Padding="12,8" ToolTipService.ToolTip="Targets +5 %" />
                    </StackPanel>
                    <Button Content="End workout" Command="{x:Bind ViewModel.EndWorkoutCommand}" Style="{StaticResource KineticDangerButtonStyle}" Visibility="{x:Bind ViewModel.IsWorkoutActive, Mode=OneWay}"
                            ToolTipService.ToolTip="Stop following the workout; the ride keeps recording" />
                    <Button Content="Workouts" Command="{x:Bind ViewModel.ChooseWorkoutCommand}" Style="{StaticResource FooterButton}" Visibility="{x:Bind c:Bind.Collapsed(ViewModel.IsWorkoutActive), Mode=OneWay}" />
                    <Button Content="Clear" Command="{x:Bind ViewModel.ClearWorkoutCommand}" Style="{StaticResource FooterButton}"
                            Visibility="{x:Bind c:Bind.VisibleIfFirstOnly(ViewModel.HasWorkout, ViewModel.IsWorkoutActive), Mode=OneWay}" ToolTipService.ToolTip="Free ride instead" />
                    <Button Content="Calibrate" Command="{x:Bind ViewModel.StartCalibrationCommand}" Style="{StaticResource FooterButton}" IsEnabled="{x:Bind ViewModel.CanCalibrate, Mode=OneWay}"
                            ToolTipService.ToolTip="Spin-down calibration (sensor must be connected)" />
                    <Button Command="{x:Bind ViewModel.ToggleVoiceCommand}" Style="{StaticResource FooterButton}"
                            ToolTipService.ToolTip="Turn the spoken workout cues on or off">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind ViewModel.VoiceGlyph, Mode=OneWay}" FontSize="16" />
                            <TextBlock Text="{x:Bind ViewModel.VoiceButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{x:Bind ViewModel.CueText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource KineticAccentBrush}" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock Text="{x:Bind ViewModel.HintText, Mode=OneWay}" FontSize="15" Foreground="{ThemeResource KineticTextSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock Text="{x:Bind ViewModel.SavedText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource KineticTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Content="Rides folder" Command="{x:Bind ViewModel.OpenExportFolderCommand}" Style="{StaticResource FooterButton}" Visibility="{x:Bind ViewModel.HasSaved, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!-- Interval pop-up (Kinetic signature): title, duration in green, target in power yellow -->
        <Border Visibility="{x:Bind ViewModel.IsPopupVisible, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{ThemeResource KineticAccentBrush}" BorderThickness="1" Background="{ThemeResource KineticSurfaceElevatedBrush}" MinWidth="420" IsHitTestVisible="False">
            <StackPanel>
                <Border Background="{ThemeResource KineticSurfaceBrush}" Padding="20,10">
                    <TextBlock Text="{x:Bind ViewModel.PopupTitle, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </Border>
                <Grid Padding="24,12" ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.PopupDuration, Mode=OneWay}" FontSize="48" Foreground="{ThemeResource KineticAccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PopupTarget, Mode=OneWay}" FontSize="48" Foreground="{ThemeResource KineticChartPowerBrush}" HorizontalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Spin-down calibration (Kinetic Fit dialog layout) -->
        <Grid Visibility="{x:Bind ViewModel.IsCalibrationOpen, Mode=OneWay}" Background="{ThemeResource KineticOverlayBrush}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="560" MaxWidth="760" Background="{ThemeResource KineticSurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource KineticBorderSubtleBrush}" BorderThickness="1">
                <StackPanel>
                    <Border Background="{ThemeResource KineticSurfaceBrush}" Padding="24,16">
                        <TextBlock Text="{x:Bind ViewModel.CalibrationText, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{x:Bind ViewModel.CalibrationBrush, Mode=OneWay}" />
                    </Border>
                    <StackPanel Padding="24,16" Spacing="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.CalibrationSpeedText, Mode=OneWay}" FontSize="96" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.CalibrationBrush, Mode=OneWay}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="{x:Bind ViewModel.SpeedUnit, Mode=OneWay}" FontSize="24" Foreground="{ThemeResource KineticTextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,20" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.CalibrationDetail, Mode=OneWay}" FontSize="20" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CalibrationPreviousText, Mode=OneWay}" FontSize="16" FontStyle="Italic" TextAlignment="Center"
                                   Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                    </StackPanel>
                    <Button Content="{x:Bind ViewModel.CalibrationCloseText, Mode=OneWay}" Command="{x:Bind ViewModel.CloseCalibrationCommand}"
                            Style="{StaticResource KineticPrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="24,0,24,20" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Post-ride summary -->
        <Grid Visibility="{x:Bind ViewModel.IsSummaryVisible, Mode=OneWay}" Background="{ThemeResource KineticOverlayBrush}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="860" Background="{ThemeResource KineticSurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource KineticBorderSubtleBrush}" BorderThickness="1">
                <StackPanel>
                    <Border Background="{ThemeResource KineticSurfaceBrush}" Padding="24,14">
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SummaryTitle, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource KineticAccentBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SummarySubtitle, Mode=OneWay}" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SummaryTiles}" Margin="16,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5" ItemWidth="160" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SummaryTile">
                                <StackPanel Margin="8">
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource KineticLabelStyle}" FontSize="12" />
                                    <TextBlock Style="{StaticResource KineticStatNumberStyle}" FontSize="30" Foreground="{ThemeResource KineticInfoBrush}">
                                        <Run Text="{x:Bind Value}" /><Run Text=" " /><Run Text="{x:Bind Unit}" FontSize="14" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind ViewModel.SummaryRecordsText, Mode=OneWay}" Margin="24,0,24,8" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource KineticWarningBrush}" TextWrapping="Wrap" Visibility="{x:Bind c:Bind.VisibleIfText(ViewModel.SummaryRecordsText), Mode=OneWay}" />
                    <Border Visibility="{x:Bind ViewModel.HasFtpResult, Mode=OneWay}" Background="{ThemeResource KineticSurfaceBrush}" Margin="24,4" Padding="16,12"
                            BorderBrush="{ThemeResource KineticAccentBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.FtpResultText, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource KineticAccentBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FtpResultDetail, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Save as my FTP" Command="{x:Bind ViewModel.SaveFtpCommand}" Style="{StaticResource KineticPrimaryButtonStyle}"
                                    VerticalAlignment="Center" Visibility="{x:Bind ViewModel.CanSaveFtp, Mode=OneWay}" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="24,12,24,20">
                        <Button Content="History" Command="{x:Bind ViewModel.OpenHistoryCommand}" Style="{StaticResource KineticOutlineButtonStyle}" />
                        <Button Content="Rides folder" Command="{x:Bind ViewModel.OpenExportFolderCommand}" Style="{StaticResource KineticOutlineButtonStyle}" />
                        <Button Content="Close" Command="{x:Bind ViewModel.DismissSummaryCommand}" Style="{StaticResource KineticPrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
