<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KineticTrainer.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Background="{ThemeResource KineticBackgroundBrush}">

    <ScrollViewer>
        <StackPanel Padding="24,16" Spacing="10" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource KineticPageTitleStyle}" />

            <TextBlock Text="TRAINER" Style="{StaticResource KineticSectionHeaderStyle}" />
            <Border Style="{StaticResource KineticCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox Header="Roller circumference (mm)" Value="{x:Bind ViewModel.RollerMm, Mode=TwoWay}" Minimum="50" Maximum="1000" SmallChange="0.1" SpinButtonPlacementMode="Inline" MinWidth="260" />
                        <Button Content="Kinetic default" Command="{x:Bind ViewModel.ResetRollerCommand}" VerticalAlignment="Bottom" Style="{StaticResource KineticOutlineButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.RollerHelp}" Foreground="{ThemeResource KineticTextSecondaryBrush}" TextWrapping="Wrap" />
                    <ComboBox Header="Sensor update rate on connect (inRide 2 custom protocol only)" ItemsSource="{x:Bind ViewModel.RateOptions}" SelectedIndex="{x:Bind ViewModel.RateIndex, Mode=TwoWay}" MinWidth="240" />
                    <ToggleSwitch Header="Reconnect to the remembered sensor automatically" IsOn="{x:Bind ViewModel.AutoReconnect, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <TextBlock Text="UNITS" Style="{StaticResource KineticSectionHeaderStyle}" />
            <Border Style="{StaticResource KineticCardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox Header="Speed" ItemsSource="{x:Bind ViewModel.SpeedUnits}" SelectedIndex="{x:Bind ViewModel.SpeedUnitIndex, Mode=TwoWay}" MinWidth="140" />
                    <ComboBox Header="Distance and body measurements" ItemsSource="{x:Bind ViewModel.DistanceUnits}" SelectedIndex="{x:Bind ViewModel.DistanceUnitIndex, Mode=TwoWay}" MinWidth="240" />
                </StackPanel>
            </Border>

            <TextBlock Text="RIDES AND WORKOUTS" Style="{StaticResource KineticSectionHeaderStyle}" />
            <Border Style="{StaticResource KineticCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox Header="Export folder (FIT and TCX files)" Text="{x:Bind ViewModel.ExportFolder, Mode=TwoWay}" MinWidth="480" />
                        <Button Content="Browse…" Command="{x:Bind ViewModel.BrowseExportFolderCommand}" VerticalAlignment="Bottom" Style="{StaticResource KineticOutlineButtonStyle}" />
                    </StackPanel>
                    <ComboBox Header="Live power graph width" ItemsSource="{x:Bind ViewModel.GraphOptions}" SelectedIndex="{x:Bind ViewModel.GraphIndex, Mode=TwoWay}" MinWidth="180" />
                    <Slider Header="On-target band for workouts (± % of target, never narrower than ±5 W)" Value="{x:Bind ViewModel.Tolerance, Mode=TwoWay}"
                            Minimum="1" Maximum="25" StepFrequency="1" TickFrequency="1" MaxWidth="420" HorizontalAlignment="Left" />
                    <ToggleSwitch Header="Colour workout profiles by power zone (off = Kinetic Fit green gradient)" IsOn="{x:Bind ViewModel.ColorByZone, Mode=TwoWay}" />
                    <ToggleSwitch Header="Show a pop-up when each interval starts" IsOn="{x:Bind ViewModel.IntervalPopups, Mode=TwoWay}" />
                    <ToggleSwitch Header="Play countdown and interval tones" IsOn="{x:Bind ViewModel.AudioCues, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ToggleSwitch Header="Speak workout cues (Windows offline voice; also on the Ride screen's Voice button)" IsOn="{x:Bind ViewModel.SpokenCues, Mode=TwoWay}" />
                        <Button Content="Test audio" Command="{x:Bind ViewModel.TestAudioCommand}" VerticalAlignment="Bottom" Style="{StaticResource KineticOutlineButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="UNITY SIMULATOR BRIDGE (THIS PC ONLY)" Style="{StaticResource KineticSectionHeaderStyle}" />
            <Border Style="{StaticResource KineticCardStyle}">
                <StackPanel Spacing="10">
                    <ToggleSwitch Header="Enable TCP telemetry server on 127.0.0.1" IsOn="{x:Bind ViewModel.BridgeEnabled, Mode=TwoWay}" />
                    <NumberBox Header="Port" Value="{x:Bind ViewModel.BridgePort, Mode=TwoWay}" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Inline" MinWidth="200" HorizontalAlignment="Left" />
                    <TextBlock Text="Newline-delimited JSON, one line per sensor packet. Never exposed to the network." Foreground="{ThemeResource KineticTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="DIAGNOSTICS" Style="{StaticResource KineticSectionHeaderStyle}" />
            <Border Style="{StaticResource KineticCardStyle}">
                <StackPanel Spacing="6">
                    <ToggleSwitch Header="Write packet/event log to a file (for checking against the real sensor)" IsOn="{x:Bind ViewModel.WriteLogFile, Mode=TwoWay}" />
                    <ToggleSwitch Header="Show the simulated sensor in the device list" IsOn="{x:Bind ViewModel.ShowSimulated, Mode=TwoWay}" />
                    <ToggleSwitch Header="Ignore System ID length validation (diagnostic only)" IsOn="{x:Bind ViewModel.IgnoreSystemId, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.DatabaseText}" Foreground="{ThemeResource KineticTextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind ViewModel.VersionText}" Foreground="{ThemeResource KineticTextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,24">
                <Button Content="Save settings" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource KineticPrimaryButtonStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
