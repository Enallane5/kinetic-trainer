<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KineticTrainer.App.Views.WorkoutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:KineticTrainer.App.Controls"
    xmlns:vm="using:KineticTrainer.App.ViewModels"
    NavigationCacheMode="Required"
    Background="{ThemeResource KineticBackgroundBrush}">

    <Grid Padding="24,16" RowSpacing="10" ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" MinWidth="380" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Workouts" Style="{StaticResource KineticPageTitleStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Import .zwo" Command="{x:Bind ViewModel.ImportCommand}" Style="{StaticResource KineticOutlineButtonStyle}" />
                <Button Content="New workout" Command="{x:Bind ViewModel.NewWorkoutCommand}" Style="{StaticResource KineticOutlineButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Search workouts" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" MinWidth="120"
                          ToolTipService.ToolTip="Sort" />
            </Grid>
            <ListView ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                      SelectionMode="Single" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollMode="Disabled" Height="44">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,4" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="BorderBrush" Value="{ThemeResource KineticAccentBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" FontSize="13" CharacterSpacing="40" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- List -->
        <ListView Grid.Row="2" Grid.Column="0" ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                    <Setter Property="Background" Value="{ThemeResource KineticSurfaceBrush}" />
                    <Setter Property="CornerRadius" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkoutItem">
                    <Grid Padding="12,8" RowSpacing="4" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="44" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Category}" FontSize="11" CharacterSpacing="80" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                            <Border Visibility="{x:Bind HasBadge}" BorderBrush="{ThemeResource KineticAccentBrush}" BorderThickness="1" Padding="5,0">
                                <TextBlock Text="{x:Bind Badge}" FontSize="10" Foreground="{ThemeResource KineticAccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="TIME" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource KineticTextSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind DurationText}" FontSize="16" Foreground="{ThemeResource KineticAccentBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="IF" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource KineticTextSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind IfText}" FontSize="16" Foreground="{ThemeResource KineticTextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="TSS" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource KineticTextSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind TssText}" FontSize="16" Foreground="{ThemeResource KineticTextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <c:WorkoutProfileChart Grid.Row="2" Grid.ColumnSpan="2" Compact="True" Timeline="{x:Bind Timeline}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Detail -->
        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="{x:Bind ViewModel.Selected.Category, Mode=OneWay}" Style="{StaticResource KineticLabelStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.DetailStats, Mode=OneWay}" Foreground="{ThemeResource KineticAccentBrush}" TextWrapping="Wrap" />
                <c:WorkoutProfileChart Height="200" Timeline="{x:Bind ViewModel.Selected.Timeline, Mode=OneWay}" Ftp="{x:Bind ViewModel.ChartFtp, Mode=OneWay}"
                                       ColorByZone="{x:Bind ViewModel.ColorByZone, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Ride this workout" Command="{x:Bind ViewModel.RideCommand}" Style="{StaticResource KineticPrimaryButtonStyle}" />
                    <Button Content="Export .zwo" Command="{x:Bind ViewModel.ExportCommand}" Style="{StaticResource KineticOutlineButtonStyle}" />
                    <Button Content="Edit" Command="{x:Bind ViewModel.EditCommand}" Style="{StaticResource KineticOutlineButtonStyle}" Visibility="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                    <Button Content="Copy and edit" Command="{x:Bind ViewModel.EditCommand}" Style="{StaticResource KineticOutlineButtonStyle}"
                            Visibility="{x:Bind c:Bind.Collapsed(ViewModel.CanEdit), Mode=OneWay}" />
                    <Button Content="Delete" Click="OnDeleteClick" Style="{StaticResource KineticDangerButtonStyle}" Visibility="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="{ThemeResource KineticWarningBrush}" TextWrapping="Wrap"
                           Visibility="{x:Bind c:Bind.VisibleIfText(ViewModel.StatusText), Mode=OneWay}" />
                <Border Style="{StaticResource KineticCardStyle}" BorderBrush="{ThemeResource KineticAccentBrush}" Visibility="{x:Bind c:Bind.VisibleIfText(ViewModel.TestText), Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.TestText, Mode=OneWay}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{x:Bind ViewModel.Selected.Description, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource KineticTextSecondaryBrush}" />

                <TextBlock Text="TIME IN ZONES" Style="{StaticResource KineticSectionHeaderStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.DetailZones}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ZoneBar">
                            <Grid ColumnSpacing="10" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Label}" />
                                <Rectangle Grid.Column="1" Height="12" Width="{x:Bind BarWidth}" MaxWidth="200" HorizontalAlignment="Left" Fill="{x:Bind Brush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind TimeText}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind RangeText}" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="STEPS" Style="{StaticResource KineticSectionHeaderStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.DetailSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StepLine">
                            <Grid ColumnSpacing="10" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{x:Bind Brush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Time}" Foreground="{ThemeResource KineticAccentBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Text}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
