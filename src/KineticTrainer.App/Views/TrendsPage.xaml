<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KineticTrainer.App.Views.TrendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:KineticTrainer.App.Controls"
    xmlns:vm="using:KineticTrainer.App.ViewModels"
    NavigationCacheMode="Required"
    Background="{ThemeResource KineticBackgroundBrush}">

    <ScrollViewer>
        <StackPanel Padding="24,16" Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource KineticPageTitleStyle}">
                    <Run Text="Trends" /><Run Text="  ·  " Foreground="{ThemeResource KineticTextSecondaryBrush}" /><Run Text="{x:Bind ViewModel.RiderName, Mode=OneWay}" Foreground="{ThemeResource KineticAccentBrush}" />
                </TextBlock>
                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.RangeOptions}" SelectedIndex="{x:Bind ViewModel.RangeIndex, Mode=TwoWay}" MinWidth="170" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="{ThemeResource KineticTextSecondaryBrush}" Visibility="{x:Bind c:Bind.VisibleIfText(ViewModel.StatusText), Mode=OneWay}" />

            <Border Style="{StaticResource KineticCardStyle}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="190" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SummaryTile">
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource KineticLabelStyle}" FontSize="11" />
                                <TextBlock Text="{x:Bind Value}" FontSize="30" Foreground="{ThemeResource KineticAccentBrush}" />
                                <TextBlock Text="{x:Bind Unit}" FontSize="12" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid ColumnSpacing="12" Height="220">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:BarChart x:Name="HoursChart" Title="RIDING TIME (HOURS)" />
                <c:BarChart x:Name="DistanceChart" Grid.Column="1" Title="DISTANCE" />
            </Grid>
            <c:BarChart x:Name="TssChart" Height="220" Title="TRAINING LOAD (TSS)" />
            <c:LineChart x:Name="FitnessChart" Height="200" Title="FITNESS (CTL, GREEN) AND FATIGUE (ATL, PINK)" />
            <TextBlock Text="{x:Bind ViewModel.LoadNote, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource KineticTextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
