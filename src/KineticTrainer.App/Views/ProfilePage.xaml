<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KineticTrainer.App.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:KineticTrainer.App.Controls"
    xmlns:vm="using:KineticTrainer.App.ViewModels"
    NavigationCacheMode="Required"
    Background="{ThemeResource KineticBackgroundBrush}">

    <Grid Padding="24,16" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Riders -->
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Riders" Style="{StaticResource KineticPageTitleStyle}" />
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Profiles}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="{ThemeResource KineticSurfaceBrush}" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="CornerRadius" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileItem">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="40" Height="40">
                                <Ellipse Fill="{x:Bind Brush}" />
                                <TextBlock Text="{x:Bind Initials}" Foreground="Black" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind FtpText}" FontSize="12" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ActiveText}" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource KineticAccentBrush}" Visibility="{x:Bind IsActive}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Grid.Row="2" Content="Add a rider" Command="{x:Bind ViewModel.NewProfileCommand}" Style="{StaticResource KineticOutlineButtonStyle}" HorizontalAlignment="Stretch" />
        </Grid>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="12" Padding="0,0,12,16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource KineticPageTitleStyle}" Foreground="{ThemeResource KineticAccentBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Ride as this rider" Command="{x:Bind ViewModel.UseProfileCommand}" Style="{StaticResource KineticPrimaryButtonStyle}"
                                Visibility="{x:Bind ViewModel.CanUse, Mode=OneWay}" />
                        <Button Content="Take an FTP test" Command="{x:Bind ViewModel.TakeFtpTestCommand}" Style="{StaticResource KineticOutlineButtonStyle}"
                                Visibility="{x:Bind c:Bind.Collapsed(ViewModel.IsNew), Mode=OneWay}" />
                        <Button Content="Delete rider" Click="OnDeleteClick" Style="{StaticResource KineticDangerButtonStyle}" Visibility="{x:Bind ViewModel.CanDelete, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- Details -->
                <Border Style="{StaticResource KineticCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="RIDER DETAILS" Style="{StaticResource KineticLabelStyle}" />
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Grid.ColumnSpan="2" Header="Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" MaxLength="40" />
                            <NumberBox Grid.Column="2" Header="FTP (W)" Value="{x:Bind ViewModel.Ftp, Mode=TwoWay}" Minimum="50" Maximum="800" PlaceholderText="unknown"
                                       SpinButtonPlacementMode="Compact" SmallChange="5" />
                            <ComboBox Grid.Column="3" Header="Badge colour" ItemsSource="{x:Bind ViewModel.ColorOptions}" SelectedIndex="{x:Bind ViewModel.ColorIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ColorOption">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Rectangle Width="16" Height="16" Fill="{x:Bind Brush}" />
                                            <TextBlock Text="{x:Bind Hex}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <NumberBox Grid.Row="1" Header="{x:Bind c:ColorFunctions.Label('Weight', ViewModel.WeightUnit), Mode=OneWay}" Value="{x:Bind ViewModel.Weight, Mode=TwoWay}" PlaceholderText="optional" />
                            <NumberBox Grid.Row="1" Grid.Column="1" Header="{x:Bind c:ColorFunctions.Label('Height', ViewModel.HeightUnit), Mode=OneWay}" Value="{x:Bind ViewModel.Height, Mode=TwoWay}" PlaceholderText="optional" />
                            <NumberBox Grid.Row="1" Grid.Column="2" Header="Birth year" Value="{x:Bind ViewModel.BirthYear, Mode=TwoWay}" PlaceholderText="optional" />
                            <ComboBox Grid.Row="1" Grid.Column="3" Header="Sex" ItemsSource="{x:Bind ViewModel.SexOptions}" SelectedIndex="{x:Bind ViewModel.SexIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <NumberBox Grid.Row="2" Header="Max heart rate" Value="{x:Bind ViewModel.MaxHr, Mode=TwoWay}" PlaceholderText="optional" />
                            <NumberBox Grid.Row="2" Grid.Column="1" Header="Resting heart rate" Value="{x:Bind ViewModel.RestHr, Mode=TwoWay}" PlaceholderText="optional" />
                            <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="12">
                                <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource KineticPrimaryButtonStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.DerivedText, Mode=OneWay}" Foreground="{ThemeResource KineticAccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Foreground="{ThemeResource KineticWarningBrush}" TextWrapping="Wrap"
                                   Visibility="{x:Bind c:Bind.VisibleIfText(ViewModel.Message), Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource KineticTextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Everything stays on this computer. FTP sets your zones, workout targets, IF and TSS; weight gives W/kg." />
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="12" Visibility="{x:Bind c:Bind.Collapsed(ViewModel.IsNew), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Records -->
                    <Border Style="{StaticResource KineticCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="RECORDS" Style="{StaticResource KineticLabelStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="MAX POWER" Style="{StaticResource KineticLabelStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.MaxPowerText, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource KineticChartPowerBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.MaxPowerDate, Mode=OneWay}" Foreground="{ThemeResource KineticTextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecordTiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="150" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SummaryTile">
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource KineticLabelStyle}" FontSize="11" />
                                            <TextBlock Foreground="{ThemeResource KineticInfoBrush}" FontSize="20">
                                                <Run Text="{x:Bind Value}" /><Run Text=" " /><Run Text="{x:Bind Unit}" FontSize="12" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="BEST POWER" Style="{StaticResource KineticSectionHeaderStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Bests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BestRow">
                                        <Grid ColumnSpacing="12" Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Duration}" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Watts}" Foreground="{ThemeResource KineticChartPowerBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind WattsPerKg}" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                                            <HyperlinkButton Grid.Column="3" Content="{x:Bind Date}" Tag="{x:Bind RideId}" Click="OnBestClick" Padding="0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Simulated rides never count as records." FontSize="12" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Zones and FTP history -->
                    <StackPanel Grid.Column="1" Spacing="12">
                        <Border Style="{StaticResource KineticCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="POWER ZONES" Style="{StaticResource KineticLabelStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Zones}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ZoneRow">
                                            <Grid ColumnSpacing="10" Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Fill="{x:Bind Brush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Label}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind PercentText}" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind RangeText}" Foreground="{ThemeResource KineticChartPowerBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KineticCardStyle}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="FTP HISTORY" Style="{StaticResource KineticLabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.FtpChartText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                                </StackPanel>
                                <c:LineChart x:Name="FtpChart" Height="140" Unit="W" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.FtpHistory}" MaxHeight="200">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer><ItemsPresenter /></ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FtpRow">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Date}" Foreground="{ThemeResource KineticTextSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Ftp}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Source}" Foreground="{ThemeResource KineticTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
