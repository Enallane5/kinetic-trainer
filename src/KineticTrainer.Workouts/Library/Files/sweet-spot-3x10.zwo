<workout_file>
    <author>Kinetic Trainer</author>
    <name>Sweet Spot 3x10</name>
    <description>Three 10-minute sweet-spot efforts at 92% FTP with 5-minute recoveries to raise FTP efficiently. On a fluid trainer, shift gears and adjust cadence to bring your power up to each target.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Warm up gradually; add a few 1-minute high-cadence spins near the end"/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="300" OnPower="0.92" OffPower="0.55">
            <textevent timeoffset="0" message="Interval 1 of 3"/>
            <textevent timeoffset="900" message="Interval 2 of 3"/>
            <textevent timeoffset="1800" message="Interval 3 of 3"/>
        </IntervalsT>
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.40"/>
    </workout>
</workout_file>
